{
  "manifest_version": 2,
  "name": "Research Highlight AI",
  "version": "0.2.1",
  "author": "fisherish",
  "description": "Turn Zotero literature highlights into structured, reusable research knowledge with configurable AI providers.",
  "homepage_url": "https://github.com/fisherish/research-highlight-toolkit",
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "applications": {
    "zotero": {
      "id": "research-highlight-ai@fisherish.github.io",
      "update_url": "https://raw.githubusercontent.com/fisherish/research-highlight-toolkit/main/zotero-plugin/updates.json",
      "strict_min_version": "10.0",
      "strict_max_version": "10.0.*"
    }
  }
}
